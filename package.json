{
  "name": "@hraness/convex",
  "version": "0.1.0",
  "description": "Validated Convex deployment configuration and fail-closed Vercel build tooling.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/convex.git"
  },
  "homepage": "https://github.com/hraness/convex#readme",
  "bugs": {
    "url": "https://github.com/hraness/convex/issues"
  },
  "keywords": [
    "convex",
    "deployment",
    "typescript",
    "vercel"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vercel-build": {
      "types": "./src/vercel-build.ts",
      "import": "./dist/vercel-build.js",
      "default": "./dist/vercel-build.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src/index.ts",
    "src/vercel-build.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.2 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.2 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.2 check --root kb && bunx --bun github:hraness/kb#v0.15.2 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.2 catalog --root kb",
    "build": "bun run ./scripts/build.ts",
    "check:portfolio-inventory": "bun run ./scripts/check-portfolio-inventory.ts",
    "check:public-boundary": "bun run ./scripts/check-public-boundary.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:property": "bun test ./src/*.property.test.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check": "bun run check:portfolio-inventory && bun run check:public-boundary && bun run lint && bun run typecheck && bun run build && bun run test && bun run test:property && bun run test:package && bun run kb:check",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.2",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
